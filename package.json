{
  "name": "comicmutant",
  "private": true,
  "version": "0.1.0",
  "description": "ComicMutant — animated superhero fan site: 100 character themes, canvas mini-games, trivia, gossip and debates. React Router + Motion + SQLite.",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev --port 4323 --host 127.0.0.1",
    "prebuild": "tsx scripts/validate.ts && tsx scripts/validate-quiz.ts --strict && tsx scripts/validate-polls.ts && tsx scripts/validate-sacred.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production PORT=${PORT:-4335} HOST=${HOST:-127.0.0.1} react-router-serve ./build/server/index.js",
    "preview": "pnpm build && pnpm start",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "@fontsource/yatra-one": "^5.3.0",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "better-sqlite3": "^12.11.1",
    "isbot": "^5.1.36",
    "motion": "^14.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.11"
  }
}
