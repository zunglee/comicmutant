# ComicMutant — every variable the server reads. Copy to your process manager / host env.
# Production refuses to start without the first three (see SECURITY.md § Configuration).

# Public origin of the site. Drives Secure cookies and the cross-site POST check.
COMICMUTANT_ORIGIN=https://comicmutant.example
# 32+ random characters. Keys rate-limit bucket hashes and peppers password hashes.
# Changing it signs everyone out of their passwords — rotate deliberately.
COMICMUTANT_SECRET=
# Which header carries the real client IP: cf-connecting-ip (only behind Cloudflare),
# x-forwarded-for (right-most entry, appended by YOUR proxy), or none (direct serve).
COMICMUTANT_IP_HEADER=none

# Optional
COMICMUTANT_DB=data/comicmutant.db
# Expose /lab/clips (quality-gate harness) in production. Leave unset.
# COMICMUTANT_LAB=1
PORT=4335
HOST=127.0.0.1
